POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

JWT_SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

GROQ_API_KEY=

# Directory for uploaded files. Defaults to backend/uploads for local dev.
# Use /app/uploads in Docker/Render deployments.
UPLOAD_DIR=

# Directory for per-project DuckDB sandbox files. Defaults to backend/sandboxes
# for local dev. Use /app/sandboxes in Docker/Render deployments.
SANDBOX_DIR=

# Schema management is normally handled via Alembic migrations.
# Set to true only for quick local bootstrapping to auto-create tables on startup.
AUTO_CREATE_TABLES=false

# Set to true to seed (once, idempotently) the public read-only "Pagila DVD
# Rental Analysis" demo project on startup. Requires DEMO_DATABASE_URL to
# point at a read-only-role Postgres database already loaded with the
# Pagila dataset (pagila-schema.sql / pagila-data.sql at the repo root).
SEED_DEMO_PROJECT=false
DEMO_DATABASE_URL=